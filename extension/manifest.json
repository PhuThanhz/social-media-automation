{
  "manifest_version": 3,
  "name": "ToolZutter - 1-Click FB & Threads Scraper",
  "version": "1.4.4",
  "description": "Tiện ích bắt link bài viết Facebook & Threads 1-chạm, tự đồng bộ cookie Facebook & Threads vào ToolZutter SAAS.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.threads.net/*",
    "*://*.threads.com/*",
    "http://localhost:8081/*",
    "http://localhost:3001/*",
    "http://localhost/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:8081/*",
    "http://127.0.0.1:3001/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ToolZutter Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "css": [
        "content/content-style.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:5173/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "content/dashboard-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}